#!/usr/bin/env bash
# Code Ocean run script for the TCS reproducibility capsule.
# Runs all analysis scripts in sequence and collects outputs into the results folder.
set -uo pipefail

# Always work from the directory containing this script, regardless of caller CWD
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Code Ocean capsules collect outputs from /results; fall back to ../results locally
if [ -d /results ]; then
  RESULTS_DIR=/results
else
  RESULTS_DIR="$SCRIPT_DIR/../results"
fi
mkdir -p "$RESULTS_DIR"

# Conda starter environments provide python; fall back to python3
PY="$(command -v python || command -v python3)"

# Move generated artifacts into the results folder (runs after EVERY script,
# so partial progress survives an interrupted run). Also sweeps one level of
# subdirectories (Main_Fig_1_and_ED_Fig_1_ab.py writes omega_kappa_figures/).
collect() {
  find . -mindepth 1 -maxdepth 2 -type f \
    \( -name '*.pdf' -o -name '*.png' -o -name '*.svg' \
       -o -name '*.xlsx' -o -name '*.csv' -o -name '*.txt' \) \
    ! -name 'requirements.txt' \
    -exec mv -f {} "$RESULTS_DIR/" \;
  find . -mindepth 1 -maxdepth 1 -type d -empty -delete
}

for f in *.py; do
  echo "================================================"
  echo "Running $f"
  echo "================================================"
  "$PY" -u "$f" || echo "WARNING: $f exited with an error; continuing."
  collect
done

echo "All scripts finished. Outputs collected in $RESULTS_DIR"
