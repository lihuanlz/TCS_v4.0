#!/usr/bin/env bash
# Code Ocean run script for the TCS reproducibility capsule.
# Runs all analysis scripts in sequence and collects outputs into the results folder.
set -uo pipefail

# Always work from the directory containing this script, regardless of caller CWD
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Code Ocean capsules collect outputs from /results; fall back to ../results locally
if [ -d /results ]; then
  RESULTS_DIR=/results
else
  RESULTS_DIR="$SCRIPT_DIR/../results"
fi
mkdir -p "$RESULTS_DIR"

# Conda starter environments provide python; fall back to python3
PY="$(command -v python || command -v python3)"

# Move ONLY the files generated or updated by the script that just ran (i.e.
# newer than the per-script stamp) into the results folder. Input data that is
# read but never rewritten (brightfield_bead_annotations.csv,
# brightfield_droplet_annotations.csv, fig3c_brightfield.png,
# fig3c_fluorescence.png, fonts/) is therefore never swept away, which a
# plain extension-based sweep would break (ED_Fig_3 reads the annotation CSVs
# only after ED_Fig_2a has already run).
collect() {
  find . -mindepth 1 -maxdepth 2 -type f -newer "$STAMP" \
    \( -name '*.pdf' -o -name '*.png' -o -name '*.svg' \
       -o -name '*.xlsx' -o -name '*.csv' -o -name '*.txt' \) \
    ! -name 'requirements.txt' \
    -exec mv -f {} "$RESULTS_DIR/" \;
  find . -mindepth 1 -maxdepth 1 -type d -empty -delete
}

STAMP=".run_stamp"
for f in *.py; do
  echo "================================================"
  echo "Running $f"
  echo "================================================"
  touch "$STAMP"
  sleep 1
  "$PY" -u "$f" || echo "WARNING: $f exited with an error; continuing."
  collect
  rm -f "$STAMP"
done

echo "All scripts finished. Outputs collected in $RESULTS_DIR"
